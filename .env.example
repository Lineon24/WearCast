# .env.local 파일을 만들고 아래 값을 실제 OpenAI API 키로 채워주세요.
# .env.local은 .gitignore(*.local)에 이미 걸려 있어 커밋되지 않습니다.
# VITE_ 접두사가 없으므로 백엔드(server/index.js)에서만 읽고, 프런트엔드 번들에는 포함되지 않습니다.
OPENAI_API_KEY=sk-proj-...

# 백엔드 프록시 서버 포트 (선택, 기본값 8787)
SERVER_PORT=8787

# OpenWeatherMap API 키 (https://openweathermap.org/api 에서 발급)
# VITE_ 접두사가 붙어있어서 Vite가 빌드 시 프런트엔드 번들에 그대로 포함시킵니다.
# 즉 브라우저에서 여전히 조회 가능합니다 - 소스코드/git에 하드코딩하지 않기 위한 최소한의 조치입니다.
# 완전히 숨기려면 이 프로젝트의 날씨 API 호출도 챗봇처럼 백엔드 프록시를 거치도록 바꿔야 합니다.
VITE_OPENWEATHER_API_KEY=your-openweathermap-key
