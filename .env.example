# .env.local 파일을 만들고 아래 값을 실제 OpenAI API 키로 채워주세요.
# .env.local은 .gitignore(*.local)에 이미 걸려 있어 커밋되지 않습니다.
# VITE_ 접두사가 없으므로 백엔드(server/index.js)에서만 읽고, 프런트엔드 번들에는 포함되지 않습니다.
OPENAI_API_KEY=sk-proj-...

# 백엔드 프록시 서버 포트 (선택, 기본값 8787)
SERVER_PORT=8787

# OpenWeatherMap API 키 (https://openweathermap.org/api 에서 발급)
# VITE_ 접두사가 없습니다 - 이제 날씨 API 호출도 챗봇처럼 백엔드 프록시(api/weather.js·server/index.js)를
# 거치도록 바뀌어서, 이 키는 서버에서만 읽고 브라우저에는 전혀 노출되지 않습니다.
OPENWEATHER_API_KEY=your-openweathermap-key
